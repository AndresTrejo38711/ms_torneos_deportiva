              "mode": "raw",
              "raw": "{\n  \"name\": \"FUTBOL {{suffix}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "La base no distingue mayúsculas ni tildes: FUTBOL y Fútbol son el mismo nombre."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 409\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "pm.test(\"errorCase = ALREADY_EXISTS\", function () {",
                  "    pm.expect(pm.response.json().errorCase).to.eql(\"ALREADY_EXISTS\");",
                  "});"
                ]
              }
            }
          ]
        },
