# Copia este archivo como .env y ajusta los valores de tu PC (el .env no se sube al repo).
# Si una variable también existe en las variables de entorno del sistema, gana la del sistema.

PORT=8182

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# Si ya tienes DB_PASSWORD en las variables de entorno de Windows, deja esta línea comentada.
# DB_PASSWORD=
DB_NAME=torneos_deportiva_db
# true muestra en la consola el SQL que se ejecuta.
DB_LOGGING=false

# ms_torneos_security: valida el token y los permisos de cada petición.
SECURITY_URL=http://localhost:8181
# false apaga esa validación mientras los permisos de este microservicio no estén registrados
# en ms_torneos_security. Si se borra la línea, queda encendida (true).
SECURITY_ENABLED=true
