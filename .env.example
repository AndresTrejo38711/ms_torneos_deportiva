# Copia este archivo como .env y ajusta los valores de tu PC (el .env no se sube al repo).
# Si una variable también existe en las variables de entorno del sistema, gana la del sistema.

PORT=8182

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
# Si ya tienes DB_PASSWORD en las variables de entorno de Windows, deja esta línea comentada.
# DB_PASSWORD=
DB_NAME=torneos_deportiva_db
# true muestra en la consola el SQL que se ejecuta.
DB_LOGGING=false

# ms_torneos_security: valida el token y los permisos de cada petición.
SECURITY_URL=http://localhost:8181
# false apaga esa validación mientras los permisos de este microservicio no estén registrados
# en ms_torneos_security. Si se borra la línea, queda encendida (true).
SECURITY_ENABLED=true

# ms_notificaciones: entrega los correos de partidos y apuestas (HU-GC-06, 07 y 11). Si se borra la
# línea, no se envían correos y la consola lo avisa; lo demás funciona igual.
NOTIFICATIONS_URL=http://localhost:5000

# Pasarela de pago de la venta de entradas (HU-GE-04). "simulada" no mueve dinero (aprueba al instante,
# salvo las tarjetas de prueba de ePayco) y es la que usan las pruebas de Postman. "epayco" cobra con
# ePayco (Davipay) y necesita las llaves de abajo. Si se borra la línea, queda la simulada.
PAYMENTS_PROVIDER=simulada

# Llaves de ePayco: dashboard de Davipay → Configuración → Personalizaciones → Llaves secretas. Son
# privadas: solo van en el .env, nunca en el repo ni en un chat.
EPAYCO_P_CUST_ID_CLIENTE=
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
# true: modo de pruebas (tarjetas de prueba, sin dinero real). Si se borra la línea, queda en true.
EPAYCO_TEST=true
# El front: ePayco devuelve ahí al aficionado después de pagar.
FRONT_URL=http://localhost:5173
